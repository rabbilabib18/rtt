<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tasnim Jahan Nafila | Finance Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0f2942;       /* Executive Navy */
      --accent: #0d9488;        /* Financial Teal */
      --accent-light: #f0fdfa;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --radius: 14px;
      --shadow: 0 10px 25px -5px rgba(15, 41, 66, 0.06), 0 4px 10px -6px rgba(15, 41, 66, 0.04);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg);
      color: var(--text-main);
      line-height: 1.65;
    }

    /* Navigation */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .nav-container {
      max-width: 1040px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--primary);
      text-decoration: none;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text-main);
      font-size: 0.92rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    /* Main Wrapper */
    main {
      max-width: 1040px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    section {
      padding: 4rem 0;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.9rem;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .section-subtitle {
      color: var(--text-muted);
      font-size: 0.98rem;
      margin-bottom: 2.2rem;
    }

    /* Hero Section */
    .hero {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 3rem;
      align-items: center;
      padding: 4.5rem 0 3.5rem;
    }

    .badge {
      display: inline-block;
      background: var(--accent-light);
      color: var(--accent);
      font-weight: 600;
      font-size: 0.82rem;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      margin-bottom: 1rem;
      border: 1px solid #ccfbf1;
    }

    .hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.85rem;
      line-height: 1.2;
      color: var(--primary);
      margin-bottom: 0.6rem;
    }

    .hero-role {
      font-size: 1.12rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 1.2rem;
    }

    .hero-bio {
      color: var(--text-muted);
      font-size: 1.02rem;
      margin-bottom: 1.8rem;
    }

    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.4rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover {
      background: #1e3a5f;
      transform: translateY(-1px);
    }

    .btn-outline {
      background: var(--surface);
      color: var(--primary);
      border: 1px solid var(--border);
    }

    .btn-outline:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Profile Photo Card */
    .profile-wrapper {
      display: flex;
      justify-content: center;
    }

    .profile-card {
      width: 290px;
      height: 330px;
      border-radius: 20px;
      background: linear-gradient(135deg, var(--primary) 0%, #1d4ed8 100%);
      padding: 6px;
      box-shadow: var(--shadow);
      position: relative;
    }

    .profile-inner {
      width: 100%;
      height: 100%;
      border-radius: 16px;
      background: #e2e8f0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--primary);
    }

    .profile-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .placeholder-initials {
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--primary);
      letter-spacing: 2px;
    }

    .placeholder-note {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.4rem;
      padding: 0 1rem;
    }

    /* Cards & Grids */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      box-shadow: var(--shadow);
      transition: transform 0.2s ease;
    }

    .card:hover {
      transform: translateY(-3px);
    }

    .card h3 {
      font-size: 1.18rem;
      color: var(--primary);
      margin-bottom: 0.6rem;
    }

    .card-meta {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent);
      margin-bottom: 0.75rem;
      display: block;
    }

    .card p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Skills Tags */
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-top: 1.2rem;
    }

    .tag {
      background: #f1f5f9;
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: 500;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      border: 1px solid var(--border);
    }

    /* Project Featured Card */
    .project-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 5px solid var(--accent);
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .project-card p {
      margin: 0.8rem 0 1.5rem;
      color: var(--text-muted);
    }

    /* Activity Image Placeholder */
    .activity-img {
      width: 100%;
      height: 165px;
      border-radius: 10px;
      background: linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%);
      border: 1px dashed #94a3b8;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 0.85rem;
      overflow: hidden;
    }

    .activity-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Contact Box */
    .contact-box {
      background: var(--primary);
      color: #ffffff;
      border-radius: 18px;
      padding: 3rem 2rem;
      text-align: center;
    }

    .contact-box h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      margin-bottom: 0.75rem;
    }

    .contact-box p {
      color: #cbd5e1;
      max-width: 560px;
      margin: 0 auto 2rem;
    }

    .contact-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .contact-btn {
      background: #ffffff;
      color: var(--primary);
      padding: 0.8rem 1.4rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.92rem;
      transition: all 0.2s;
    }

    .contact-btn:hover {
      background: var(--accent);
      color: #ffffff;
    }

    footer {
      text-align: center;
      padding: 2rem 1rem;
      color: var(--text-muted);
      font-size: 0.88rem;
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }

    /* Responsive Mobile Design */
    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 3rem 0 2rem;
      }
      .hero h1 {
        font-size: 2.2rem;
      }
      .btn-group {
        justify-content: center;
      }
      .profile-wrapper {
        order: -1;
      }
      .profile-card {
        width: 230px;
        height: 265px;
      }
      .grid-2, .grid-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
